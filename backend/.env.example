# ServiceHub Backend Environment & API Keys Template

PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key

# Razorpay Payment Gateway API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP Email Credentials
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password_or_app_token

# Government KYC Verification API Keys
NSDL_PAN_API_KEY=your_nsdl_pan_api_key
GSTIN_API_KEY=your_gstin_api_key
RBI_IFSC_API_KEY=your_ifsc_api_key

# SMS OTP Gateway Credentials
SMS_GATEWAY_API_KEY=your_sms_gateway_key
SMS_SENDER_ID=SRVHUB
